      ],
      "source": [
        "def merge_sort(a):\n",
        "    if len(a) <= 1:\n",
        "        return a\n",
        "\n",
        "    mid = len(a) // 2\n",
        "    left = merge_sort(a[:mid])\n",
        "    right = merge_sort(a[mid:])\n",
        "\n",
        "    return sorted(left + right)\n",
        "\n",
        "a = [5, 2, 8, 1, 3]\n",
        "print(\"Sorted:\", merge_sort(a))"
      ]
    }
  ]
}